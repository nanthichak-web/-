rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == "nanthicha.k@ubu.ac.th" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    match /test/connection {
      allow read: if true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTournament(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.type in ["Opb", "Opb Upgrade", "Stock Class", "Open Class"] &&
             data.date is string &&
             data.status in ["registration", "active", "finished"];
    }

    function isValidParticipant(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.carCount is number && data.carCount >= 0;
    }

    function isValidRound(data) {
      return data.stage is number && data.stage > 0 &&
             data.index is number &&
             data.slots is list && data.slots.size() > 0 && data.slots.size() <= 3 &&
             data.isFinished is bool;
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if isAdmin() && isValidTournament(incoming());
      allow update: if (isAdmin() || isSignedIn()) && isValidTournament(incoming()) && (
        (existing().status != "finished") || isAdmin()
      );
      allow delete: if isAdmin();

      match /participants/{participantId} {
        allow read: if true;
        allow create, update: if isAdmin() && isValidParticipant(incoming());
        allow delete: if isAdmin();
      }

      match /rounds/{roundId} {
        allow read: if true;
        allow create: if isAdmin() && isValidRound(incoming());
        allow update: if (isAdmin() || isSignedIn()) && isValidRound(incoming()) && (
          (!existing().isFinished) || isAdmin()
        );
        allow delete: if isAdmin();
      }
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || request.auth.token.email == "nanthicha.k@ubu.ac.th";
    }
  }
}
